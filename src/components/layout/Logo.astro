---
/**
 * Placeholder wordmark for the prototype — not the real Abans Tiken Tika Pay
 * logo. Swap the mark and text when brand assets arrive.
 */
interface Props {
  /** `dark` inverts the wordmark for use on primary backgrounds. */
  tone?: "light" | "dark";
  class?: string;
}

const { tone = "light", class: className } = Astro.props;
---

<a
  href="/"
  aria-label="Tiken Tika Pay — home"
  class:list={[
    "group inline-flex items-center gap-2.5 transition-transform duration-200 ease-state hover:scale-[1.02]",
    className,
  ]}
>
  <span
    class:list={[
      "grid h-9 w-9 place-items-center rounded-[11px] transition-colors duration-200 ease-state",
      tone === "dark" ? "bg-white" : "bg-primary group-hover:bg-primary-hover",
    ]}
  >
    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" aria-hidden="true">
      <path
        d="M4 7a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-5.5L7 19.5V16H7a3 3 0 0 1-3-3Z"
        fill={tone === "dark" ? "#791F7F" : "#FFFFFF"}
      ></path>
      <path
        d="M8.5 8.5h7M8.5 11.5h4"
        stroke={tone === "dark" ? "#FFFFFF" : "#791F7F"}
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </svg>
  </span>

  <span
    class:list={[
      "text-[17px] font-bold leading-none tracking-[-0.02em]",
      tone === "dark" ? "text-white" : "text-text",
    ]}
  >
    tikentika<span
      class:list={[tone === "dark" ? "text-primary-200" : "text-primary"]}
      >pay</span
    >
  </span>
</a>
