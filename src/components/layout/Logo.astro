---
/**
 * The image already carries its own purple/black wordmark, so on the dark
 * footer it sits on a white plate rather than being recoloured.
 */
interface Props {
  /** `dark` sets a white backing plate for use on dark backgrounds. */
  tone?: "light" | "dark";
  class?: string;
}

const { tone = "light", class: className } = Astro.props;
---

<a
  href="/"
  aria-label="Abans Smartphones — home"
  class:list={[
    "group inline-flex items-center transition-transform duration-200 ease-state hover:scale-[1.02]",
    className,
  ]}
>
  <span
    class:list={[
      "inline-flex items-center rounded-[11px] transition-colors duration-200 ease-state",
      tone === "dark" ? "bg-white px-3 py-1.5" : "",
    ]}
  >
    <img src="/smartphonelogo.png" alt="Abans Smartphones" class="h-8 w-auto" />
  </span>
</a>
