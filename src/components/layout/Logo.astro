---
/**
 * `dark` swaps in the pre-made white wordmark (footer.png) so the logo sits
 * directly on the dark footer with no backing plate.
 */
interface Props {
  /** `dark` swaps in the white wordmark for use on dark backgrounds. */
  tone?: "light" | "dark";
  class?: string;
}

const { tone = "light", class: className } = Astro.props;
---

<a
  href="/"
  aria-label="Abans Smartphones — home"
  class:list={[
    "group inline-flex items-center transition-transform duration-200 ease-state hover:scale-[1.02]",
    className,
  ]}
>
  <img
    src={tone === "dark" ? "/footer.png" : "/smartphonelogo.png"}
    alt="Abans Smartphones"
    class:list={["w-auto", tone === "dark" ? "h-11" : "h-8"]}
  />
</a>
