---
import { navLinks as links } from "../../lib/nav";
import Logo from "./Logo.astro";

interface Props {
  /** The apply flow gets a stripped-back nav — no links, no menu. */
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
---

<header
  data-nav
  class="sticky top-0 z-40 bg-bg/80 backdrop-blur-xl transition-shadow duration-200 ease-state"
>
  <div
    class="mx-auto flex h-18 max-w-[1200px] items-center justify-between px-6"
  >
    <Logo />

    {
      !minimal && (
        <>
          <nav aria-label="Main" class="hidden items-center gap-8 md:flex">
            {links.map((link) => (
              <a
                href={link.href}
                class="text-[15px] text-text-muted transition-colors duration-200 ease-state hover:text-primary"
              >
                {link.label}
              </a>
            ))}
          </nav>

          <a
            href="/#affordability"
            class="inline-flex h-11 items-center rounded-full bg-primary px-5 text-[15px] font-semibold text-white shadow-rest transition-all duration-200 ease-state hover:scale-[1.02] hover:bg-primary-hover hover:shadow-raised sm:px-6"
          >
            Let's Find Your Phone
          </a>
        </>
      )
    }

    {
      minimal && (
        <a
          href="/"
          class="group inline-flex items-center gap-2 text-[15px] text-text-muted transition-colors duration-200 ease-state hover:text-primary"
        >
          {/* Same chevron as the device page's back control. */}
          <svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0" aria-hidden="true">
            <path
              d="M9.5 3.5 5 8l4.5 4.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          Back to phones
        </a>
      )
    }
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");

  if (nav) {
    // Nav only earns its shadow once the page has moved.
    const update = () => {
      nav.classList.toggle("shadow-rest", window.scrollY > 8);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
