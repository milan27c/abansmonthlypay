---
import Logo from "./Logo.astro";

/**
 * The reference header's tab set. "Pay Monthly" is this prototype's own page and
 * carries the active (primary) treatment. Home / Smartphones / Accessories /
 * Offers point at the main Abans storefront (a separate site). "Contact" has no
 * destination yet, so it renders as an inert label rather than a dead link.
 */
const store = "https://abanssmartphones1.vercel.app";
const tabs = [
  { label: "Home", href: `${store}/` },
  { label: "Smartphones", href: `${store}/products?category=smartphones` },
  { label: "Accessories", href: `${store}/products?category=accessories` },
  { label: "Pay Monthly", href: "/", active: true },
  { label: "Offers", href: `${store}/products?filter=offers` },
  { label: "Contact" },
];

/**
 * "Shop by brand" grid inside the mobile menu — mirrors the storefront's own
 * menu. Wordmarks live in `public/brands/` on white, so they need
 * `mix-blend-multiply` on the tinted tile. Each tile links to the storefront
 * filtered by brand. `redmi.png` is the orange Mi glyph the reference uses for
 * Xiaomi.
 */
const menuBrands = [
  { slug: "apple", name: "Apple", logo: "/brands/apple.png" },
  { slug: "xiaomi", name: "Xiaomi", logo: "/brands/redmi.png" },
  { slug: "motorola", name: "Motorola", logo: "/brands/motorola.png" },
  { slug: "oppo", name: "Oppo", logo: "/brands/oppo.png" },
  { slug: "vivo", name: "Vivo", logo: "/brands/vivo.png" },
  { slug: "realme", name: "Realme", logo: "/brands/realme.png" },
  { slug: "itel", name: "Itel", logo: "/brands/itel.png" },
  { slug: "tecno", name: "Tecno", logo: "/brands/tecno.png" },
  { slug: "infinix", name: "Infinix", logo: "/brands/infinix.png" },
];

/** Standing campaign line — dismissible, no real trade-in flow behind it. */
const announcement = "Trade in your old phone and save on your next one";
---

<div data-announce class="bg-primary text-white">
  <div class="flex min-h-11 items-center gap-4 px-6 py-2">
    <p
      class="flex-1 text-center text-[13px] font-medium tracking-[0.01em] sm:text-[14px]"
    >
      {announcement}
    </p>
    <button
      type="button"
      data-announce-close
      aria-label="Dismiss announcement"
      class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-white/75 transition-colors duration-200 ease-state hover:bg-white/10 hover:text-white"
    >
      <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
        <path
          d="m4.5 4.5 11 11M15.5 4.5l-11 11"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</div>

<header
  data-nav
  class="sticky top-0 z-40 bg-bg/80 backdrop-blur-xl transition-shadow duration-200 ease-state"
>
  <div
    class="relative mx-auto flex h-18 max-w-[1200px] items-center justify-between px-6"
  >
    <Logo />

    <nav
      aria-label="Main"
      class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-1 md:flex"
    >
      {
        tabs.map((tab) =>
          tab.active ? (
            <a
              href={tab.href}
              aria-current="page"
              class="px-3 text-[14px] font-medium text-primary transition-colors duration-200 ease-state hover:text-primary-hover"
            >
              {tab.label}
            </a>
          ) : tab.href ? (
            <a
              href={tab.href}
              class="px-3 text-[14px] font-normal text-text transition-colors duration-200 ease-state hover:text-primary"
            >
              {tab.label}
            </a>
          ) : (
            <span class="px-3 text-[14px] font-normal text-text transition-colors duration-200 ease-state hover:text-primary">
              {tab.label}
            </span>
          ),
        )
      }
    </nav>

    <button
      type="button"
      aria-label="Search"
      class="hidden h-10 w-10 shrink-0 items-center justify-center text-text transition-colors duration-200 ease-state hover:text-primary md:inline-flex"
    >
      <svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true">
        <circle
          cx="9"
          cy="9"
          r="6.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"></circle>
        <path
          d="m18 18-4.35-4.35"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <button
      type="button"
      data-menu-toggle
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center text-text transition-colors duration-200 ease-state hover:text-primary md:hidden"
    >
      <svg
        data-icon-menu
        viewBox="0 0 20 20"
        class="h-5 w-5"
        aria-hidden="true"
      >
        <path
          d="M3 5.5h14M3 10h14M3 14.5h14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
      <svg
        data-icon-close
        viewBox="0 0 20 20"
        class="hidden h-5 w-5"
        aria-hidden="true"
      >
        <path
          d="m4.5 4.5 11 11M15.5 4.5l-11 11"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<!--
  Rendered as a body-level sibling, not inside <header>: the header's
  `backdrop-blur` establishes a containing block for `position: fixed`, which
  would otherwise pin this sheet to the 72px header box instead of the viewport.
-->
<div
  id="mobile-menu"
  data-mobile-menu
  class="pointer-events-none fixed inset-0 z-50 translate-y-2 overflow-y-auto bg-bg opacity-0 transition-[opacity,transform] duration-300 ease-state md:hidden"
>
    <div class="mx-auto min-h-full w-full max-w-[560px] px-6 pb-16 pt-5">
      <div class="flex justify-end">
        <button
          type="button"
          data-menu-close
          aria-label="Close menu"
          class="grid h-11 w-11 place-items-center rounded-full text-text transition-colors duration-200 ease-state hover:text-primary"
        >
          <svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true">
            <path
              d="m4.5 4.5 11 11M15.5 4.5l-11 11"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <nav
        aria-label="Mobile"
        class="mt-1 flex flex-col divide-y divide-divider"
      >
        <a
          href={tabs[0].href}
          class="block py-6 text-[26px] font-semibold tracking-[-0.02em] text-text transition-colors duration-200 ease-state hover:text-primary"
        >
          {tabs[0].label}
        </a>

        <a
          href={tabs[1].href}
          class="block py-6 text-[26px] font-semibold tracking-[-0.02em] text-text transition-colors duration-200 ease-state hover:text-primary"
        >
          {tabs[1].label}
        </a>

        <div class="py-6">
          <p
            class="text-[13px] font-medium uppercase tracking-[0.12em] text-text-muted"
          >
            Shop by brand
          </p>
          <div class="mt-5 grid grid-cols-3 gap-3 sm:gap-4">
            {
              menuBrands.map((brand) => (
                <a
                  href={`${store}/products?brand=${brand.slug}`}
                  aria-label={brand.name}
                  class="flex aspect-[16/11] items-center justify-center rounded-2xl bg-text/[0.04] transition-colors duration-200 ease-state hover:bg-text/[0.06]"
                >
                  <img
                    src={brand.logo}
                    alt={brand.name}
                    loading="lazy"
                    class="max-h-7 max-w-[68%] object-contain mix-blend-multiply"
                  />
                </a>
              ))
            }
          </div>
        </div>

        {
          tabs.slice(2).map((tab) =>
            tab.href ? (
              <a
                href={tab.href}
                data-menu-link={tab.active ? "" : undefined}
                aria-current={tab.active ? "page" : undefined}
                class="block py-6 text-[26px] font-semibold tracking-[-0.02em] text-text transition-colors duration-200 ease-state hover:text-primary"
              >
                {tab.label}
              </a>
            ) : (
              <span class="block py-6 text-[26px] font-semibold tracking-[-0.02em] text-text">
                {tab.label}
              </span>
            ),
          )
        }
      </nav>
    </div>
</div>

<script>
  // Announcement bar — dismiss for the rest of the browsing session.
  const announce = document.querySelector<HTMLElement>("[data-announce]");
  const announceClose = document.querySelector<HTMLButtonElement>(
    "[data-announce-close]",
  );

  if (announce && announceClose) {
    try {
      if (sessionStorage.getItem("announce-dismissed") === "1") {
        announce.hidden = true;
      }
    } catch {
      /* storage unavailable — bar just stays visible */
    }

    announceClose.addEventListener("click", () => {
      announce.hidden = true;
      try {
        sessionStorage.setItem("announce-dismissed", "1");
      } catch {
        /* ignore */
      }
    });
  }

  const nav = document.querySelector<HTMLElement>("[data-nav]");

  if (nav) {
    // Nav only earns its shadow once the page has moved.
    const update = () => {
      nav.classList.toggle("shadow-rest", window.scrollY > 8);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  const menuToggle = document.querySelector<HTMLButtonElement>(
    "[data-menu-toggle]",
  );
  const menuClose = document.querySelector<HTMLButtonElement>(
    "[data-menu-close]",
  );
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const iconMenu = document.querySelector<SVGElement>("[data-icon-menu]");
  const iconClose = document.querySelector<SVGElement>("[data-icon-close]");

  if (menuToggle && mobileMenu && iconMenu && iconClose) {
    const setOpen = (open: boolean) => {
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      // Full-screen sheet — fade + settle, and pin the page behind it.
      mobileMenu.classList.toggle("opacity-0", !open);
      mobileMenu.classList.toggle("pointer-events-none", !open);
      mobileMenu.classList.toggle("translate-y-2", !open);
      iconMenu.classList.toggle("hidden", open);
      iconClose.classList.toggle("hidden", !open);
      document.body.style.overflow = open ? "hidden" : "";
    };

    menuToggle.addEventListener("click", () => {
      setOpen(menuToggle.getAttribute("aria-expanded") !== "true");
    });

    menuClose?.addEventListener("click", () => setOpen(false));

    // Closing on link activation covers the one real destination in the menu.
    mobileMenu
      .querySelector<HTMLAnchorElement>("[data-menu-link]")
      ?.addEventListener("click", () => setOpen(false));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
