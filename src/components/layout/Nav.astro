---
import Logo from "./Logo.astro";

interface Props {
  /** The apply flow gets a stripped-back nav — no links, no menu. */
  minimal?: boolean;
}

const { minimal = false } = Astro.props;

/**
 * Matches the reference header's tab set. Only "Pay Monthly" is a real
 * destination — this prototype doesn't have Products/Accessories/Blog/Contact
 * pages, so those render as inert labels rather than dead links.
 */
const inertTabs = ["Home", "Products", "Accessories", "Blog", "Contact"];

/** Decorative only — no real Abans social accounts wired up in this prototype. */
const socialLinks = ["Facebook", "Instagram", "YouTube", "TikTok"];
---

{
  !minimal && (
    <div class="hidden border-b border-divider bg-bg sm:block">
      <div class="mx-auto flex h-9 max-w-[1200px] items-center gap-3 px-6">
        {socialLinks.map((label) => (
          <a
            href="#"
            aria-label={label}
            class="grid h-7 w-7 place-items-center rounded-full text-text-muted transition-colors duration-200 ease-state hover:text-primary"
          >
            {label === "Facebook" && (
              <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                <path
                  d="M13 3.5h-1.6a3.4 3.4 0 0 0-3.4 3.4V8.8H6.2v2.8H8v5.4h2.8v-5.4h2.1l.4-2.8h-2.5V7.2c0-.66.54-1.2 1.2-1.2H13Z"
                  fill="currentColor"
                />
              </svg>
            )}
            {label === "Instagram" && (
              <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                <rect
                  x="3.5"
                  y="3.5"
                  width="13"
                  height="13"
                  rx="4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <circle
                  cx="10"
                  cy="10"
                  r="3.3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <circle cx="13.9" cy="6.1" r="0.9" fill="currentColor" />
              </svg>
            )}
            {label === "YouTube" && (
              <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                <rect
                  x="2.5"
                  y="5.5"
                  width="15"
                  height="9"
                  rx="3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path d="M8.7 8.3v3.4l3-1.7Z" fill="currentColor" />
              </svg>
            )}
            {label === "TikTok" && (
              <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                <path
                  d="M12 3.2v8.3a2.5 2.5 0 1 1-2-2.44"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
                <path
                  d="M12 3.2c.3 1.75 1.65 3.05 3.4 3.25"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  )
}

<header
  data-nav
  class="sticky top-0 z-40 bg-bg/80 backdrop-blur-xl transition-shadow duration-200 ease-state"
>
  <div
    class="mx-auto flex h-18 max-w-[1200px] items-center justify-between px-6"
  >
    <Logo />

    {
      !minimal && (
        <div class="hidden items-center gap-6 md:flex">
          <nav aria-label="Main" class="flex items-center gap-2">
            {inertTabs.map((label) => (
              <span class="px-3 text-[12px] font-medium tracking-[0.02em] text-text-muted uppercase">
                {label}
              </span>
            ))}
            <a
              href="/"
              aria-current="page"
              class="inline-flex h-10 items-center rounded-full bg-primary px-5 text-[12px] font-semibold tracking-[0.02em] text-white uppercase shadow-rest transition-all duration-200 ease-state hover:scale-[1.02] hover:bg-primary-hover hover:shadow-raised"
            >
              Pay Monthly
            </a>
          </nav>

          <button
            type="button"
            aria-label="Search"
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center text-text transition-colors duration-200 ease-state hover:text-primary"
          >
            <svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true">
              <circle
                cx="9"
                cy="9"
                r="6.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              ></circle>
              <path
                d="m18 18-4.35-4.35"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              ></path>
            </svg>
          </button>
        </div>
      )
    }

    {
      minimal && (
        <a
          href="/"
          class="group inline-flex items-center gap-2 text-[15px] text-text-muted transition-colors duration-200 ease-state hover:text-primary"
        >
          {/* Same chevron as the device page's back control. */}
          <svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0" aria-hidden="true">
            <path
              d="M9.5 3.5 5 8l4.5 4.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          Back to phones
        </a>
      )
    }
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");

  if (nav) {
    // Nav only earns its shadow once the page has moved.
    const update = () => {
      nav.classList.toggle("shadow-rest", window.scrollY > 8);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
