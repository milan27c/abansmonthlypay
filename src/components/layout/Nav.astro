---
import { navLinks as links } from "../../lib/nav";
import Logo from "./Logo.astro";

interface Props {
  /** The apply flow gets a stripped-back nav — no links, no menu. */
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
---

<header
  data-nav
  class="sticky top-0 z-40 bg-bg/80 backdrop-blur-xl transition-shadow duration-200 ease-state"
>
  <div
    class="mx-auto flex h-18 max-w-[1200px] items-center justify-between px-6"
  >
    <Logo />

    {
      !minimal && (
        <>
          <nav aria-label="Main" class="hidden items-center gap-8 md:flex">
            {links.map((link) => (
              <a
                href={link.href}
                class="text-[15px] text-text-muted transition-colors duration-200 ease-state hover:text-primary"
              >
                {link.label}
              </a>
            ))}
          </nav>

          <div class="flex items-center gap-2">
            <a
              href="/#affordability"
              class="inline-flex h-11 items-center rounded-full bg-primary px-5 text-[15px] font-semibold text-white shadow-rest transition-all duration-200 ease-state hover:scale-[1.02] hover:bg-primary-hover hover:shadow-raised sm:px-6"
            >
              {/* The full line does not fit beside the logo and the menu
                  button on a phone, so the small screen drops the lead-in. */}
              <span class="hidden sm:inline">Let's Find Your Phone</span>
              <span class="sm:hidden">Find Your Phone</span>
            </a>

            <button
              type="button"
              data-menu-toggle
              aria-expanded="false"
              aria-controls="mobile-menu"
              aria-label="Open menu"
              class="grid h-11 w-11 shrink-0 cursor-pointer place-items-center rounded-full bg-surface text-text-muted shadow-rest transition-all duration-200 ease-state hover:scale-[1.02] hover:text-primary md:hidden"
            >
              <svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true">
                <path
                  d="M3.5 6h13M3.5 10h13M3.5 14h13"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>
            </button>
          </div>
        </>
      )
    }

    {
      minimal && (
        <a
          href="/"
          class="text-[15px] text-text-muted transition-colors duration-200 ease-state hover:text-primary"
        >
          Back to phones
        </a>
      )
    }
  </div>

  {
    !minimal && (
      <nav
        id="mobile-menu"
        aria-label="Main"
        hidden
        class="px-6 pb-4 md:hidden"
      >
        <ul class="flex flex-col gap-1 rounded-card bg-surface p-2 shadow-rest">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                data-menu-link
                class="block rounded-input px-4 py-3 text-[15px] text-text transition-colors duration-200 ease-state hover:bg-primary-soft hover:text-primary"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");

  if (nav) {
    // Nav only earns its shadow once the page has moved.
    const update = () => {
      nav.classList.toggle("shadow-rest", window.scrollY > 8);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    toggle.addEventListener("click", () => {
      setOpen(menu.hidden === true);
    });

    // Any link closes it — every destination is on this page.
    menu.querySelectorAll("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
