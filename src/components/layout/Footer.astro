---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();

/*
  Footer navigation is site chrome lifted from the live Abans Smartphones
  footer. This prototype only has Home, Showrooms and the Pay Monthly tab as
  real destinations, so every other entry renders as an inert label styled to
  match — no dead links.
*/
type Link = { label: string; href?: string };

const linkColumns: { title: string; links: Link[] }[] = [
  {
    title: "Brands",
    links: [
      { label: "Apple" },
      { label: "OPPO" },
      { label: "Motorola" },
      { label: "Redmi" },
      { label: "vivo" },
      { label: "realme" },
      { label: "Infinix" },
      { label: "TECNO" },
    ],
  },
  {
    title: "Shop",
    links: [
      { label: "All Smartphones", href: "/" },
      { label: "New Arrivals" },
      { label: "Best Sellers" },
      { label: "Offers" },
      { label: "Shop By Budget", href: "/" },
    ],
  },
  {
    title: "Support",
    links: [
      { label: "Warranty" },
      { label: "Service Centres" },
      { label: "Delivery" },
      { label: "Payment Plans", href: "/" },
      { label: "FAQs" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About Abans" },
      { label: "Showrooms", href: "/#showrooms" },
      { label: "Careers" },
      { label: "Blog" },
      { label: "Contact" },
    ],
  },
];

/** Decorative only — no real Abans social accounts wired up in this prototype. */
const socialLinks = ["Facebook", "Instagram", "YouTube", "TikTok"];

const legalLinks = ["Privacy Policy", "Terms Of Use", "Returns"];
---

<footer class="mt-24 bg-black">
  <div class="mx-auto max-w-[1200px] px-6 py-14 lg:py-20">
    <div
      class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-[1.7fr_1fr_1fr_1fr_1fr] lg:gap-8"
    >
      {/* Brand + intro + social */}
      <div>
        <Logo tone="dark" />

        <p class="mt-6 max-w-[360px] text-[14px] leading-[1.6] text-white/50">
          Abans Smartphones brings you unmatched confidence and convenience in
          owning world-renowned smartphone brands. Enjoy authentic devices at
          the best prices, backed by a trusted warranty and exceptional
          after-sales support.
        </p>

        <div class="mt-10 flex items-center gap-6">
          {
            socialLinks.map((label) => (
              <a
                href="#"
                aria-label={label}
                class="text-white/40 transition-colors duration-200 ease-state hover:text-white"
              >
                {label === "Facebook" && (
                  <svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true">
                    <path
                      d="M13 3.5h-1.6a3.4 3.4 0 0 0-3.4 3.4V8.8H6.2v2.8H8v5.4h2.8v-5.4h2.1l.4-2.8h-2.5V7.2c0-.66.54-1.2 1.2-1.2H13Z"
                      fill="currentColor"
                    />
                  </svg>
                )}
                {label === "Instagram" && (
                  <svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true">
                    <rect
                      x="3.5"
                      y="3.5"
                      width="13"
                      height="13"
                      rx="4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <circle
                      cx="10"
                      cy="10"
                      r="3.3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <circle cx="13.9" cy="6.1" r="0.9" fill="currentColor" />
                  </svg>
                )}
                {label === "YouTube" && (
                  <svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true">
                    <rect
                      x="2.5"
                      y="5.5"
                      width="15"
                      height="9"
                      rx="3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <path d="M8.7 8.3v3.4l3-1.7Z" fill="currentColor" />
                  </svg>
                )}
                {label === "TikTok" && (
                  <svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true">
                    <path
                      d="M12 3.2v8.3a2.5 2.5 0 1 1-2-2.44"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                    <path
                      d="M12 3.2c.3 1.75 1.65 3.05 3.4 3.25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      {/* Link columns */}
      {
        linkColumns.map((column) => (
          <div>
            <h3 class="text-[15px] font-medium text-white">{column.title}</h3>
            <ul class="mt-6 space-y-4">
              {column.links.map((link) => (
                <li>
                  {link.href ? (
                    <a
                      href={link.href}
                      class="text-[14px] text-white/50 transition-colors duration-200 ease-state hover:text-white"
                    >
                      {link.label}
                    </a>
                  ) : (
                    <span class="text-[14px] text-white/50">{link.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Contact row */}
    <div class="mt-14 border-t border-white/10 pt-10">
      <div
        class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8"
      >
        <div class="flex items-start gap-3">
          <svg
            viewBox="0 0 20 20"
            class="mt-0.5 h-5 w-5 shrink-0 text-white/40"
            aria-hidden="true"
          >
            <path
              d="M5 3.5c1 .3 2 .8 2.3 1.4.3.6-.1 1.2-.6 1.7-.5.5-.6.9-.3 1.5.7 1.4 2 2.7 3.4 3.4.6.3 1 .2 1.5-.3.5-.5 1.1-.9 1.7-.6.6.3 1.1 1.3 1.4 2.3.2.7-1 2-1.8 2.1-1.3.2-2.9-.3-4.6-1.5-1.9-1.3-3.3-2.9-4.3-4.7C2.4 7.2 1.9 5.6 2.1 4.3 2.2 3.5 3.5 2.3 5 3.5Z"
              fill="currentColor"
            />
          </svg>
          <div>
            <p
              class="text-[12px] font-medium tracking-[0.08em] text-white/40 uppercase"
            >
              General
            </p>
            <p class="mt-1 text-[15px] text-white">011 22 22 888</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg
            viewBox="0 0 20 20"
            class="mt-0.5 h-5 w-5 shrink-0 text-white/40"
            aria-hidden="true"
          >
            <rect
              x="2.5"
              y="4.5"
              width="15"
              height="11"
              rx="2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
            />
            <path
              d="m3.2 5.3 6.8 5 6.8-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <div class="min-w-0">
            <p
              class="text-[12px] font-medium tracking-[0.08em] text-white/40 uppercase"
            >
              Email
            </p>
            <p class="mt-1 text-[15px] break-words text-white">
              abansmobilemarketing@abansgroup.com
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg
            viewBox="0 0 20 20"
            class="mt-0.5 h-5 w-5 shrink-0 text-white/40"
            aria-hidden="true"
          >
            <path
              d="M10 18s5.5-5 5.5-9.5A5.5 5.5 0 0 0 4.5 8.5C4.5 13 10 18 10 18Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"
            />
            <circle
              cx="10"
              cy="8.3"
              r="2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
            />
          </svg>
          <div>
            <p
              class="text-[12px] font-medium tracking-[0.08em] text-white/40 uppercase"
            >
              Address
            </p>
            <p class="mt-1 text-[15px] text-white">
              498, Galle Road, Colombo 03, Sri Lanka
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3 lg:justify-self-end">
          <svg
            viewBox="0 0 20 20"
            class="mt-0.5 h-5 w-5 shrink-0 text-white/40"
            aria-hidden="true"
          >
            <circle
              cx="10"
              cy="10"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
            />
            <path
              d="M3 10h14M10 3c1.8 1.9 2.8 4.4 2.8 7s-1 5.1-2.8 7c-1.8-1.9-2.8-4.4-2.8-7s1-5.1 2.8-7Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
            />
          </svg>
          <div>
            <p
              class="text-[12px] font-medium tracking-[0.08em] text-white/40 uppercase"
            >
              Our Sites
            </p>
            <p class="mt-1 text-[15px] text-white">abansgroup.com</p>
            <p class="mt-1 text-[15px] text-white">buyabans.com</p>
          </div>
        </div>
      </div>
    </div>

    {/* Bottom bar */}
    <div
      class="mt-10 flex flex-col items-center gap-4 border-t border-white/10 pt-6 sm:flex-row sm:justify-between"
    >
      <p class="text-[13px] text-white/50">
        © {year} Abans PLC. All Rights Reserved.
      </p>

      <div class="flex items-center gap-8">
        {
          legalLinks.map((label) => (
            <a
              href="#"
              class="text-[13px] text-white/50 transition-colors duration-200 ease-state hover:text-white"
            >
              {label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
