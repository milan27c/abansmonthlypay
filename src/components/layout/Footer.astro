---
import { brandById } from "../../data/brands";
import { devices } from "../../data/devices";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();

/*
  Quick Links matches the header's tab set (see Nav.astro): only Home,
  Showrooms and the new Monthly Pay tab go anywhere real — this prototype
  doesn't have Products/Accessories/Blog/Contact pages, so those render as
  inert labels rather than dead links.
*/
const quickLinks: { label: string; href?: string }[] = [
  { label: "Home", href: "/" },
  { label: "Products" },
  { label: "Accessories" },
  { label: "Blog" },
  { label: "Contact Us" },
  { label: "Showrooms", href: "/#showrooms" },
  { label: "Monthly Pay", href: "/" },
];

/** A handful of catalogue devices, standing in for a "recent products" feed. */
const recentProductIds = ["vivo-x300-pro", "xiaomi-17t", "oppo-reno-16f"];
const recentProducts = recentProductIds
  .map((id) => devices.find((device) => device.id === id))
  .filter((device) => device !== undefined);

/** Decorative only — no real Abans social accounts wired up in this prototype. */
const socialLinks = ["Facebook", "Instagram", "TikTok", "YouTube", "LinkedIn"];
---

<footer class="mt-24 bg-text">
  <div class="mx-auto max-w-[1200px] px-6 py-14 lg:py-20">
    <div
      class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-[1.7fr_0.9fr_1.2fr_0.9fr] lg:gap-8"
    >
      {/* Brand + contact */}
      <div>
        <Logo tone="dark" />

        <p class="mt-6 max-w-[340px] text-[14px] leading-[1.6] text-white/55">
          Abans Smartphones brings you unmatched confidence and convenience in
          owning world-renowned smartphone brands. Enjoy authentic devices at
          the best prices, backed by a trusted warranty and exceptional
          after-sales support. Whether you seek cutting-edge performance,
          seamless connectivity, or innovative features, Abans ensures you
          stay ahead with remarkable mobile solutions tailored to your
          evolving needs.
        </p>

        <ul class="mt-8 space-y-4">
          <li class="flex items-center gap-3">
            <span
              class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white/10 text-white/70"
            >
              <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                <path
                  d="M5 3.5c1 .3 2 .8 2.3 1.4.3.6-.1 1.2-.6 1.7-.5.5-.6.9-.3 1.5.7 1.4 2 2.7 3.4 3.4.6.3 1 .2 1.5-.3.5-.5 1.1-.9 1.7-.6.6.3 1.1 1.3 1.4 2.3.2.7-1 2-1.8 2.1-1.3.2-2.9-.3-4.6-1.5-1.9-1.3-3.3-2.9-4.3-4.7C2.4 7.2 1.9 5.6 2.1 4.3 2.2 3.5 3.5 2.3 5 3.5Z"
                  fill="currentColor"
                />
              </svg>
            </span>
            <span class="text-[13px] text-white/70"
              >General: 011 22 22 888</span
            >
          </li>
          <li class="flex items-center gap-3">
            <span
              class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white/10 text-white/70"
            >
              <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                <rect
                  x="2.5"
                  y="4.5"
                  width="15"
                  height="11"
                  rx="2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
                <path
                  d="m3.2 5.3 6.8 5 6.8-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="text-[13px] text-white/70"
              >Email: abansmobilemarketing@abansgroup.com</span
            >
          </li>
          <li class="flex items-center gap-3">
            <span
              class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white/10 text-white/70"
            >
              <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                <path
                  d="M10 18s5.5-5 5.5-9.5A5.5 5.5 0 0 0 4.5 8.5C4.5 13 10 18 10 18Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linejoin="round"
                />
                <circle
                  cx="10"
                  cy="8.3"
                  r="2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
              </svg>
            </span>
            <span class="text-[13px] text-white/70"
              >Address: 498, Galle Road, Colombo 03, Sri Lanka</span
            >
          </li>
          <li class="flex items-center gap-3">
            <span
              class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white/10 text-white/70"
            >
              <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                <circle
                  cx="10"
                  cy="10"
                  r="7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
                <path
                  d="M3 10h14M10 3c1.8 1.9 2.8 4.4 2.8 7s-1 5.1-2.8 7c-1.8-1.9-2.8-4.4-2.8-7s1-5.1 2.8-7Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
              </svg>
            </span>
            <span class="text-[13px] text-white/70">abansgroup.com</span>
          </li>
          <li class="flex items-center gap-3">
            <span
              class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white/10 text-white/70"
            >
              <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                <circle
                  cx="10"
                  cy="10"
                  r="7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
                <path
                  d="M3 10h14M10 3c1.8 1.9 2.8 4.4 2.8 7s-1 5.1-2.8 7c-1.8-1.9-2.8-4.4-2.8-7s1-5.1 2.8-7Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
              </svg>
            </span>
            <span class="text-[13px] text-white/70">buyabans.com</span>
          </li>
        </ul>
      </div>

      {/* Quick Links */}
      <div>
        <h3
          class="text-[13px] font-semibold tracking-[0.08em] text-white uppercase"
        >
          Quick Links
        </h3>
        <ul class="mt-6 space-y-3">
          {
            quickLinks.map((link) =>
              link.href ? (
                <li>
                  <a
                    href={link.href}
                    class="text-[14px] text-white/55 transition-colors duration-200 ease-state hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ) : (
                <li>
                  <span class="text-[14px] text-white/55">{link.label}</span>
                </li>
              ),
            )
          }
        </ul>
      </div>

      {/* Recent Products */}
      <div>
        <h3
          class="text-[13px] font-semibold tracking-[0.08em] text-white uppercase"
        >
          Recent Products
        </h3>
        <ul class="mt-6 space-y-4">
          {
            recentProducts.map((device) => {
              const brand = brandById(device!.brand);
              return (
                <li class="flex items-start gap-3">
                  <span class="grid h-14 w-14 shrink-0 place-items-center overflow-hidden rounded-input bg-primary-50">
                    <img
                      src={device!.image}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-contain mix-blend-multiply"
                    />
                  </span>
                  <span class="min-w-0 pt-0.5">
                    <span class="block text-[11px] font-medium tracking-[0.04em] text-white/40 uppercase">
                      {brand?.name}
                    </span>
                    <span class="mt-0.5 line-clamp-2 block text-[13px] font-medium leading-[1.35] text-white/80">
                      {device!.name}
                    </span>
                  </span>
                </li>
              );
            })
          }
        </ul>
      </div>

      {/* Categories */}
      <div>
        <h3
          class="text-[13px] font-semibold tracking-[0.08em] text-white uppercase"
        >
          Categories
        </h3>
        <div class="mt-6 flex flex-wrap gap-2">
          <span
            class="rounded-full bg-white/10 px-4 py-2 text-[12px] font-medium text-white/80"
          >
            Mobiles
          </span>
          <span
            class="rounded-full bg-white/10 px-4 py-2 text-[12px] font-medium text-white/80"
          >
            Accessories
          </span>
        </div>
      </div>
    </div>

    {/* Bottom bar */}
    <div
      class="mt-12 flex flex-col items-center gap-4 border-t border-white/10 pt-6 sm:flex-row sm:justify-between"
    >
      <p class="text-[13px] text-white/55">
        © {year} Abans | Developed by Azbow
      </p>

      <div class="flex items-center gap-3">
        {
          socialLinks.map((label) => (
            <a
              href="#"
              aria-label={label}
              class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-white/60 transition-colors duration-200 ease-state hover:bg-white/20 hover:text-white"
            >
              {label === "Facebook" && (
                <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                  <path
                    d="M13 3.5h-1.6a3.4 3.4 0 0 0-3.4 3.4V8.8H6.2v2.8H8v5.4h2.8v-5.4h2.1l.4-2.8h-2.5V7.2c0-.66.54-1.2 1.2-1.2H13Z"
                    fill="currentColor"
                  />
                </svg>
              )}
              {label === "Instagram" && (
                <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                  <rect
                    x="3.5"
                    y="3.5"
                    width="13"
                    height="13"
                    rx="4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <circle
                    cx="10"
                    cy="10"
                    r="3.3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <circle cx="13.9" cy="6.1" r="0.9" fill="currentColor" />
                </svg>
              )}
              {label === "TikTok" && (
                <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                  <path
                    d="M12 3.2v8.3a2.5 2.5 0 1 1-2-2.44"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <path
                    d="M12 3.2c.3 1.75 1.65 3.05 3.4 3.25"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              )}
              {label === "YouTube" && (
                <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                  <rect
                    x="2.5"
                    y="5.5"
                    width="15"
                    height="9"
                    rx="3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <path d="M8.7 8.3v3.4l3-1.7Z" fill="currentColor" />
                </svg>
              )}
              {label === "LinkedIn" && (
                <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                  <rect
                    x="3"
                    y="3"
                    width="14"
                    height="14"
                    rx="2.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <circle cx="6.7" cy="7" r="0.9" fill="currentColor" />
                  <path
                    d="M6.7 9.3v4.4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <path
                    d="M10 13.7V10.9c0-1 .7-1.6 1.6-1.6.9 0 1.5.6 1.5 1.6v2.8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <path
                    d="M10 9.3v4.4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
