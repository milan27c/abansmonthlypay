---
import Reveal from "../ui/Reveal.astro";
import { provinces } from "../../data/locations";

const districtCount = provinces.flatMap((p) => p.districts).length;

/*
  The island-wide network, not `showrooms.length` — that module only carries a
  sample of branches for the district cascade to filter against.
*/
const NETWORK_SHOWROOMS = "400+";
---

<section id="showrooms" class="scroll-mt-24 py-14 sm:py-20">
  <div class="mx-auto max-w-[1200px] px-6">
    <Reveal>
      {/*
        The banner is 3:1, so desktop carries that ratio and the artwork lands
        uncropped. Below `lg` the panel takes its height from the copy instead
        and the image crops to the centre.
      */}
      <div
        class="relative overflow-hidden rounded-card bg-primary-900 lg:aspect-[3/1]"
      >
        {/*
          No scrim: the banner ships with the wash already baked into it.

          It also ships with a feathered transparent margin — the artwork is a
          2172 x 724 block flush to the top-right of a 2439 x 936 canvas, so
          drawn `inset-0` it leaves the panel's own background showing down the
          left and along the bottom. Sizing the image to 2439/2172 x 936/724 of
          the panel and anchoring it top-right lands that block exactly on the
          box; `object-cover` then handles the crop at widths where the panel is
          not the artwork's own 3:1.
        */}
        <img
          src="/banner2.png"
          alt=""
          loading="lazy"
          decoding="async"
          class="absolute right-0 top-0 h-[129.282%] w-[112.293%] max-w-none object-cover object-right-top"
        />

        <div
          class="relative flex h-full flex-col justify-center px-7 py-12 sm:px-12 sm:py-16 lg:max-w-[60%]"
        >
          <h2
            class="text-[28px] font-semibold tracking-[-0.02em] text-white sm:text-[32px]"
          >
            Your Nearest Abans Showroom<br class="hidden lg:inline" /> Is Always
            Within Reach
          </h2>

          <dl class="mt-8 flex flex-wrap gap-x-16 gap-y-8 sm:mt-10">
            <div>
              <dd
                class="text-[40px] font-bold leading-none tracking-[-0.02em] text-white tabular-nums"
              >
                {NETWORK_SHOWROOMS}
              </dd>
              <dt
                class="mt-2 text-[13px] font-medium tracking-[0.01em] text-primary-300"
              >
                Showrooms
              </dt>
            </div>
            <div>
              <dd
                class="text-[40px] font-bold leading-none tracking-[-0.02em] text-white tabular-nums"
              >
                {districtCount}
              </dd>
              <dt
                class="mt-2 text-[13px] font-medium tracking-[0.01em] text-primary-300"
              >
                Districts covered
              </dt>
            </div>
          </dl>
        </div>
      </div>
    </Reveal>
  </div>
</section>
