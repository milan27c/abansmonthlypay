---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/layout/Footer.astro";
import DeviceDetail from "../../components/device/DeviceDetail";
import { brandById } from "../../data/brands";
import { devices, lowestMonthly } from "../../data/devices";
import { formatLKR } from "../../lib/format";

/*
  One static page per device. The shop sends phones here instead of opening the
  modal — a full-height sheet on a small screen ends up fighting the page under
  it — and the budget rides along on `?budget=`.
*/
export function getStaticPaths() {
  return devices.map((device) => ({ params: { id: device.id } }));
}

const { id } = Astro.params;
const device = devices.find((d) => d.id === id)!;
const brand = brandById(device.brand);
const fullName = `${brand?.name ?? ""} ${device.name}`.trim();
---

<Layout
  title={`${fullName} — Abans Tiken Tika Pay`}
  description={`${fullName} from ${formatLKR(lowestMonthly(device))} a month with Abans Tiken Tika Pay.`}
>
  {/*
    A detail screen, so the top bar is a back control rather than the site nav:
    the way back to the grid is the only navigation that matters here.
  */}
  <header
    class="sticky top-0 z-40 bg-bg/80 backdrop-blur-xl transition-shadow duration-200 ease-state"
    data-nav
  >
    <div class="mx-auto flex h-18 max-w-[1200px] items-center px-6">
      <a
        href="/#phones"
        data-back
        class="group inline-flex items-center gap-2.5 text-[15px] font-medium text-text transition-colors duration-200 ease-state hover:text-primary"
      >
        <span
          class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-surface shadow-rest transition-all duration-200 ease-state group-hover:scale-[1.02] group-hover:bg-primary-100 group-hover:text-primary"
        >
          <svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true">
            <path
              d="M9.5 3.5 5 8l4.5 4.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        Back
      </a>
    </div>
  </header>

  <main class="mx-auto max-w-[1200px] px-6 py-8 sm:py-12">
    {/*
      `overflow-clip`, not `overflow-hidden`: both round off the product panel,
      but `hidden` makes this a scroll container, which would strand the sticky
      apply button.
    */}
    <div class="overflow-clip rounded-card bg-surface shadow-rest">
      {/*
        client:load — this is the whole point of the page, and the tenure picker
        has to work the moment it is on screen.
      */}
      <DeviceDetail client:load device={device} variant="page" />
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");

  if (nav) {
    // Nav only earns its shadow once the page has moved.
    const update = () => {
      nav.classList.toggle("shadow-rest", window.scrollY > 8);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  /*
    Going back through history keeps the shop exactly as it was left — budget,
    brand filter and scroll position. The `href` is the fallback for anyone who
    arrived here directly, and for a middle-click or a new tab.
  */
  const back = document.querySelector<HTMLAnchorElement>("[data-back]");

  back?.addEventListener("click", (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) {
      return;
    }

    const cameFromSite =
      document.referrer !== "" &&
      new URL(document.referrer).origin === window.location.origin;

    if (cameFromSite) {
      event.preventDefault();
      history.back();
    }
  });
</script>
